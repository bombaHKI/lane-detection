{
  "input": {
    "point_path": "data/LiDaR/871e1d886ffffff_cegl_m4_2.laz"
  },
  "context": {
    "window_size": 2,
    "window_shift": 1,
    "bin_length": 40
  },
  "stages": [
    {
      "name": "setup_output",
      "enabled": true,
      "params": {
        "base_path": "data/output"
      }
    },
    {
      "name": "car_trace",
      "enabled": true,
      "params": {
        "method": "window_median_v2",
        "load_path": "data/output/cegl_2/car_trace/npz/trace_pulse_lines.npz"
      }
    },
    {
      "name": "binning",
      "enabled": true,
      "params": {
        "time_threshold": 10.0,
        "is_ground_processed": false
      }
    },
    {
      "name": "trace_distance_filter",
      "enabled": true,
      "params": {
        "distance": 15.0
      }
    },
    {
      "name": "write_cloud",
      "enabled": false,
      "params": {
        "file_name": "1_distance",
        "all": false
      }
    },
    {
      "name": "ground_segment",
      "enabled": true,
      "params": {
        "square_size": 2.0,
        "method": "grad",
        "distance_threshold": 0.1,
        "fit_threshold": 0.05,
        "max_gradient": 0.4
      }
    },
    {
      "name": "write_cloud",
      "enabled": false,
      "params": {
        "file_name": "2_ground",
        "all": false
      }
    },
    {
      "name": "intensity_threshold",
      "enabled": true,
      "params": {
        "method": "percentile",
        "offset": 0.0,
        "min_threshold": 0.0,
        "percentile": 5.0
      }
    },
    {
      "name": "write_cloud",
      "enabled": false,
      "params": {
        "file_name": "3_intensity",
        "all": false
      }
    },
    {
      "name": "road_surface",
      "enabled": true,
      "params": {
        "rect_width": 0.5,
        "rect_len": 2.5,
        "road_surface_buffer": 0.5,
        "distance_clip": 12.0
      }
    },
    {
      "name": "write_cloud",
      "enabled": true,
      "params": {
        "file_name": "4_road_marking",
        "all": false
      }
    },
    {
      "name": "fit_lines",
      "enabled": true,
      "params": {
        "seed_distance": 5.0,
        "fit_threshold": 0.15,
        "line_width_margin": 4.0,
        "curvature_limit":  0.05,
        "min_inliers": 20,
        "ransac_iterations": 200
      }
    },
    {
      "name": "write_lines",
      "enabled": true,
      "params": {
        "file_name": "5_ransac_lines",
        "lines_crs": "EPSG:3857"
      }
    },
    {
      "name": "line_smoothing",
      "enabled": true,
      "params": {
        "window_length": 9.0,
        "output_density": 4
      }
    },
    {
      "name": "write_lines",
      "enabled": true,
      "params": {
        "file_name": "6_refined_lines",
        "lines_crs": "EPSG:3857"
      }
    }
  ]
}
